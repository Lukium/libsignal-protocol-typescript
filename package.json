{
  "name": "@lukium/libsignal-protocol-typescript",
  "version": "0.2.0-beta.1",
  "main": "lib/cjs/index.js",
  "module": "lib/esm/index.js",
  "types": "lib/cjs/index.d.ts",
  "repository": "https://github.com/Lukium/libsignal-protocol-typescript",
  "author": "Rolfe Schmidt <rolfeschmidt@gmail.com>",
  "license": "GPL-3.0-only",
  "scripts": {
    "test": "jest --config jestconfig.json",
    "test:watch": "jest --config jestconfig.json --watch",
    "test:coverage": "jest --config jestconfig.json --coverage",
    "lint": "eslint 'src/**/*.ts' 'src/__test__/**/*.ts'",
    "lint:fix": "eslint 'src/**/*.ts' 'src/__test__/**/*.ts' --fix",
    "format": "prettier '**/{*.{js?(on),ts?(x),md},.*.js?(on)}' --write --list-different --config prettier.config.js",
    "format:check": "prettier '**/{*.{js?(on),ts?(x),md},.*.js?(on)}' --check --config prettier.config.js",
    "typecheck": "tsc --noEmit",
    "dev:pwa-vite": "vite --config examples/pwa-vite/vite.config.ts",
    "prepare": "yarn run build",
    "clean": "node -e \"const fs=require('fs');const path=require('path');for (const dir of ['lib/cjs','lib/esm']) { try { fs.rmSync(dir,{recursive:true,force:true}); } catch (err) { if (err.code !== 'ENOENT') throw err; } } try { for (const entry of fs.readdirSync('lib',{withFileTypes:true})) { if (entry.isDirectory()) continue; fs.rmSync(path.join('lib', entry.name), { force: true }); } } catch (err) { if (err.code !== 'ENOENT') throw err; }\"",
    "build": "yarn clean && yarn build:cjs && yarn build:esm && node scripts/finalize-builds.mjs",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "prepublishOnly": "yarn release:beta",
    "preversion": "yarn run lint && yarn test",
    "version": "yarn run format && git add -A src",
    "postversion": "git push && git push --tags",
    "postinstall": "husky install",
    "build:pwa-vite": "vite build --config examples/pwa-vite/vite.config.ts",
    "preview:pwa-vite": "yarn build:pwa-vite && vite preview --config examples/pwa-vite/vite.config.ts --host 127.0.0.1 --port 5174",
    "test:e2e": "PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers playwright test",
    "docs:api": "typedoc --options typedoc.json",
    "bundle:size": "node scripts/measure-bundle-size.mjs",
    "smoke:build": "node scripts/smoke-build.mjs",
    "smoke:browser": "node scripts/smoke-browser-build.mjs",
    "release:beta": "yarn lint && yarn test && yarn bundle:size && yarn build && yarn smoke:build && yarn smoke:browser",
    "benchmark": "yarn build && node benchmarks/run.js",
    "benchmark:memory": "yarn build && node --expose-gc benchmarks/memory-test.js",
    "example:pwa-vite": "yarn dev:pwa-vite",
    "example:basic": "node examples/basic-messaging/demo.mjs",
    "example:chat": "yarn build:chat && node examples/cross-browser-chat/server.mjs",
    "build:chat": "yarn build && node examples/cross-browser-chat/build-bundle.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@playwright/test": "^1.49.1",
    "@types/base64-js": "^1.3.2",
    "@types/jest": "^29.5.14",
    "@types/ws": "^8",
    "@typescript-eslint/eslint-plugin": "^8.46.1",
    "@typescript-eslint/parser": "^8.46.1",
    "esbuild": "^0.25.0",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "5.5.4",
    "fake-indexeddb": "^6.2.4",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^16.2.4",
    "prettier": "^3.6.2",
    "protobufjs-cli": "^2.5.5",
    "source-map-explorer": "^2.5.3",
    "ts-jest": "^29.4.5",
    "typedoc": "0.27.3",
    "typedoc-plugin-markdown": "4.9.0",
    "typescript": "5.9.3",
    "vite": "^6.4.3",
    "ws": "^8.21.0"
  },
  "dependencies": {
    "base64-js": "^1.5.1",
    "protobufjs": "^7.6.4"
  },
  "exports": {
    ".": {
      "types": "./lib/cjs/index.d.ts",
      "import": "./lib/esm/index.js",
      "require": "./lib/cjs/index.js"
    },
    "./session-cipher": {
      "types": "./lib/cjs/session-cipher.d.ts",
      "import": "./lib/esm/session-cipher.js",
      "require": "./lib/cjs/session-cipher.js"
    },
    "./session-builder": {
      "types": "./lib/cjs/session-builder.d.ts",
      "import": "./lib/esm/session-builder.js",
      "require": "./lib/cjs/session-builder.js"
    },
    "./session-record": {
      "types": "./lib/cjs/session-record.d.ts",
      "import": "./lib/esm/session-record.js",
      "require": "./lib/cjs/session-record.js"
    },
    "./session-types": {
      "types": "./lib/cjs/session-types.d.ts",
      "import": "./lib/esm/session-types.js",
      "require": "./lib/cjs/session-types.js"
    },
    "./key-helper": {
      "types": "./lib/cjs/key-helper.d.ts",
      "import": "./lib/esm/key-helper.js",
      "require": "./lib/cjs/key-helper.js"
    },
    "./signal-protocol-address": {
      "types": "./lib/cjs/signal-protocol-address.d.ts",
      "import": "./lib/esm/signal-protocol-address.js",
      "require": "./lib/cjs/signal-protocol-address.js"
    },
    "./fingerprint-generator": {
      "types": "./lib/cjs/fingerprint-generator.d.ts",
      "import": "./lib/esm/fingerprint-generator.js",
      "require": "./lib/cjs/fingerprint-generator.js"
    },
    "./internal/crypto": {
      "types": "./lib/cjs/internal/crypto.d.ts",
      "import": "./lib/esm/internal/crypto.js",
      "require": "./lib/cjs/internal/crypto.js"
    },
    "./logger": {
      "types": "./lib/cjs/logger.d.ts",
      "import": "./lib/esm/logger.js",
      "require": "./lib/cjs/logger.js"
    },
    "./protobuf/push_messages": {
      "types": "./lib/cjs/protobuf/push_messages.d.ts",
      "import": "./lib/esm/protobuf/push_messages.js",
      "require": "./lib/cjs/protobuf/push_messages.js"
    },
    "./package.json": "./package.json"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "files": [
    "lib/cjs/**/*",
    "lib/esm/**/*",
    "lib/*.d.ts"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "packageManager": "yarn@4.10.3"
}
