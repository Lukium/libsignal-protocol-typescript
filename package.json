{
  "name": "@privacyresearch/libsignal-protocol-typescript",
  "version": "0.0.16",
  "main": "lib/cjs/index.js",
  "module": "lib/esm/index.js",
  "types": "lib/cjs/index.d.ts",
  "repository": "https://github.com/privacyresearchgroup/libsignal-protocol-typescript",
  "author": "Rolfe Schmidt <rolfeschmidt@gmail.com>",
  "license": "GPL-3.0-only",
  "scripts": {
    "test": "jest --config jestconfig.json",
    "test:watch": "jest --config jestconfig.json --watch",
    "test:coverage": "jest --config jestconfig.json --coverage",
    "lint": "eslint 'src/**/*.ts' 'src/__test__/**/*.ts'",
    "lint:fix": "eslint 'src/**/*.ts' 'src/__test__/**/*.ts' --fix",
    "format": "prettier '**/{*.{js?(on),ts?(x),md},.*.js?(on)}' --write --list-different --config prettier.config.js",
    "format:check": "prettier '**/{*.{js?(on),ts?(x),md},.*.js?(on)}' --check --config prettier.config.js",
    "typecheck": "tsc --noEmit",
    "prepare": "yarn run build",
    "clean": "node -e \"const fs=require('fs');const path=require('path');for (const dir of ['lib/cjs','lib/esm']) { try { fs.rmSync(dir,{recursive:true,force:true}); } catch (err) { if (err.code !== 'ENOENT') throw err; } } try { for (const entry of fs.readdirSync('lib',{withFileTypes:true})) { if (entry.isDirectory()) continue; if (entry.name === 'msrcrypto.js') continue; fs.rmSync(path.join('lib', entry.name), { force: true }); } } catch (err) { if (err.code !== 'ENOENT') throw err; }\"",
    "build": "yarn clean && yarn build:cjs && yarn build:esm",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "prepublishOnly": "yarn run lint",
    "preversion": "yarn run lint && yarn test",
    "version": "yarn run format && git add -A src",
    "postversion": "git push && git push --tags",
    "postinstall": "husky install"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@types/base64-js": "^1.3.2",
    "@types/jest": "^29.5.14",
    "@typescript-eslint/eslint-plugin": "^8.46.1",
    "@typescript-eslint/parser": "^8.46.1",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "5.5.4",
    "fake-indexeddb": "^6.2.4",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^16.2.4",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.5",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@privacyresearch/curve25519-typescript": "^0.0.12",
    "@privacyresearch/libsignal-protocol-protobuf-ts": "^0.0.9",
    "base64-js": "^1.5.1"
  },
  "exports": {
    ".": {
      "import": "./lib/esm/index.js",
      "require": "./lib/cjs/index.js",
      "types": "./lib/cjs/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "files": [
    "lib/cjs/**/*",
    "lib/esm/**/*",
    "lib/*.d.ts",
    "lib/msrcrypto.js"
  ],
  "packageManager": "yarn@4.10.3"
}
